# Copy this file to ".env" (same folder) and fill in your real keys.
# Never commit the real ".env" to a public repo — keep it in .gitignore.

# Groq — AI chat, summaries, quiz generation. The client no longer reads
# this: GroqService/AIConfig call the groq-proxy Cloudflare Worker
# (cloudflare/groq-proxy/), which holds the key in its own secret store.
# Set it there instead:
#   cd cloudflare/groq-proxy && wrangler secret put GROQ_API_KEY

# YouTube Data API v3 — the client no longer reads this directly.
# YoutubeRepository.refresh() calls the youtube-sync Cloudflare Worker's
# /syncNow endpoint instead (cloudflare/youtube-sync/). Set the key there:
#   cd cloudflare/youtube-sync && wrangler secret put YOUTUBE_API_KEY

# HF Spaces (public, no key needed to call — left here in case either
# Space is ever made private and needs a token)
HF_TOKEN=
