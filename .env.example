# Copy this file to ".env" (same folder) and fill in your real keys.
# Never commit the real ".env" to a public repo — keep it in .gitignore.

# Groq — AI chat, summaries, quiz generation. The client no longer reads
# this: GroqService/AIConfig call the groqChat/groqModels Cloud Function
# callables (functions/src/groqProxy.ts), which read the key from Secret
# Manager. Set it there instead:
#   firebase functions:secrets:set GROQ_API_KEY

# YouTube Data API v3 — the client no longer reads this directly.
# YoutubeRepository.refresh() calls the syncYoutubeNow Cloud Function
# callable instead (functions/src/youtubeSync.ts). Set the key there:
#   firebase functions:secrets:set YOUTUBE_API_KEY

# HF Spaces (public, no key needed to call — left here in case either
# Space is ever made private and needs a token)
HF_TOKEN=
